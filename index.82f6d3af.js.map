"use strict";
var galleryList = document.querySelector(".gallery__list");
var largeImg = document.getElementById("largeImg");
galleryList.addEventListener("click", function(e) {
    var smallImgLink = e.target.closest(".list-item__link");
    e.preventDefault();
    if (!smallImgLink) return;
    var newImg = smallImgLink.getAttribute("href");
    largeImg.setAttribute("src", newImg);
});

